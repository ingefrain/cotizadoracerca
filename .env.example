APP_NAME="Cotizador Acerca"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
MAINTENANCE_PAGE_MESSAGE="Estamos realizando una actualización."
MAINTENANCE_PAGE_SECONDARY_MESSAGE="El servicio estará disponible nuevamente en breve."
MAINTENANCE_PAGE_LOGO_URL=
MAINTENANCE_PAGE_REFRESH_SECONDS=0

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

SECURITY_LOGIN_ATTEMPT_RETENTION_DAYS=90
SECURITY_LOGIN_ATTEMPT_SCHEDULE_PRUNE=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=cotizadoracerca_dev
DB_USERNAME=cotizadoracerca_app
DB_PASSWORD=

SESSION_COOKIE=cotizadoracerca_session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=cotizadoracerca_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_PREFIX=cotizadoracerca_
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="cotizador@example.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_CONNECT_TIMEOUT=5
TELEGRAM_TIMEOUT=10

DOCUMENTS_DISK=local
DOCUMENTS_MAX_SIZE_KB=10240
DOCUMENTS_RETENTION_DAYS=90
DOCUMENTS_ORPHAN_RETENTION_DAYS=30
DOCUMENTS_AUDIT_SCAN_LIMIT=500
USER_AVATAR_MAX_SIZE_KB=5120
BRANDING_LOGO_MAX_SIZE_KB=5120
USER_AVATAR_WEBP_QUALITY=82
USER_AVATAR_MAX_WIDTH=1024
USER_AVATAR_MAX_HEIGHT=1024
BRANDING_LOGO_WEBP_QUALITY=85
BRANDING_LOGO_MAX_WIDTH=1600
BRANDING_LOGO_MAX_HEIGHT=1600
DOCUMENTS_IMAGE_MAX_INPUT_PIXELS=16000000
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=72
IMPERSONATION_MAX_MINUTES=60

NOTIFICATION_BRAND_NAME="Cotizador Acerca"
